# Copy this file to .env and adjust values for your environment.
# Do not commit .env with real secrets.

# PostgreSQL connection used by the application and drizzle-kit.
#
# For Docker Compose / self-hosted Postgres:
DATABASE_URL=postgres://whathome:changeme@postgres:5432/whathome
#
# For Vercel + Neon, use the connection string from your Neon project
# instead (the app auto-detects Neon from the "neon.tech" hostname and
# switches to Neon's WebSocket driver, which supports real transactions
# in a serverless environment):
# DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/whathome?sslmode=require

# Values used by the postgres service in compose.yaml.
POSTGRES_USER=whathome
POSTGRES_PASSWORD=changeme
POSTGRES_DB=whathome

# Port the app is published on from the host.
APP_PORT=3000
