# Copy this file to .env and adjust values for your environment.
# Do not commit .env with real secrets.

# PostgreSQL connection used by the application and drizzle-kit.
DATABASE_URL=postgres://whathome:changeme@postgres:5432/whathome

# Values used by the postgres service in compose.yaml.
POSTGRES_USER=whathome
POSTGRES_PASSWORD=changeme
POSTGRES_DB=whathome

# Port the app is published on from the host.
APP_PORT=3000
